# Production: one shared Upstash Redis database for all deployment instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set your actual public app URL or contact email to identify this application.
NOMINATIM_USER_AGENT=BetweenDistance/1.0 (https://your-app.vercel.app)
# Can be changed without editing source code; include /search.
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
# Optional tile provider; must support {z}, {x}, {y}. Set its attribution too.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
